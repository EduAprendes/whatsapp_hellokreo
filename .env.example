PORT=3000

# WhatsApp Cloud API (número de producción "Hellokreo")
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Inventado por nosotros, para el handshake GET del webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# IA que responde los mensajes entrantes
GOOGLE_API_KEY=

# A dónde avisar (número de WhatsApp, formato E.164 sin "+") cuando el flujo
# "DEMO" agenda un lead calificado. Opcional: si se deja vacío, solo se loguea.
TEAM_NOTIFY_PHONE=

# Chatwoot como dueño del canal de WhatsApp (ver docs/chatwoot-integracion.md)
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_ACCESS_TOKEN=
# Compartido con la outgoing_url del bot como ?secret=...; openssl rand -hex 16
CHATWOOT_BOT_SHARED_SECRET=

# Google Calendar (agendamiento real del flujo DEMO) — cuenta de servicio,
# no OAuth. Compartir el calendario elegido con GOOGLE_SERVICE_ACCOUNT_EMAIL
# ("Realizar cambios en los eventos") — ver docs/google-calendar-integracion.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
BUSINESS_UTC_OFFSET=-04:00
